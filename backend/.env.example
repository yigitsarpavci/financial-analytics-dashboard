# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fintech_db
DATABASE_URL=postgresql://postgres:postgres@db:5432/fintech_db

# Security
SECRET_KEY=generate_a_secure_random_string_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Deployment & CORS
FRONTEND_CORS_ORIGINS=http://localhost:3000,https://my-vercel-frontend.vercel.app

# OpenAI (Optional, required for AI Engine instead of Rule-Based Fallback)
OPENAI_API_KEY=sk-your-openai-api-key
